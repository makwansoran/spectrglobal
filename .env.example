# Public (browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_DOWNLOAD_WINDOWS=/downloads/Spectr-Setup-x64.exe
NEXT_PUBLIC_DOWNLOAD_MAC=/downloads/Spectr-Setup.dmg
NEXT_PUBLIC_DOWNLOAD_LINUX=/downloads/Spectr-Setup.AppImage

# Server-only — Command chat proxy (/api/command-chat/*)
SPECTR_COMMAND_CHAT_API_KEY=
SPECTR_COMMAND_CHAT_PROVIDER=anthropic
SPECTR_COMMAND_CHAT_BASE_URL=https://api.anthropic.com
SPECTR_COMMAND_CHAT_MODEL=claude-haiku-4-5-20251001

# Simple single-user login (dev / demos) — email + password on /login
SPECTR_DEMO_EMAIL=dev@spectr.no
SPECTR_DEMO_PASSWORD=spectr
SPECTR_DEMO_SECRET=

# Optional contact form (existing)
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=

# Admin console at /admin — comma-separated emails. Defaults to makwan@spectr.no
# SPECTR_ADMIN_EMAIL=makwan@spectr.no
