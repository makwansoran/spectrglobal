# Supabase (required for live cameras / incidents)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Model
MODEL_WEIGHTS=yolo11n.pt
INFER_DEVICE=cpu

# Local bring-up without DB cameras (optional)
DEMO_SOURCE=./samples/demo.mp4

# Runtime
CONFIG_POLL_SECONDS=5
LOCAL_EVIDENCE_DIR=./evidence
HOST=0.0.0.0
PORT=8080

# OCI Object Storage (optional — leave blank to keep evidence local)
OCI_NAMESPACE=
OCI_BUCKET=
OCI_REGION=eu-amsterdam-1
OCI_CONFIG_FILE=
